#!/bin/bash
# secret — 统一密文节点(基于 macOS Keychain)
# 用法:
#   secret set <name> <value>   写一条密钥到 Keychain
#   secret get <name>           从 Keychain 取回(供脚本用, 不落盘)
#   secret del <name>           删除
#   secret ls                   列出已存密钥名(不显示值)
# 约定: svce 固定为 "secret:<name>", account 固定 "nusun"
# 原则: 密钥只存 Keychain + 进程内存, 绝不写文件/配置, 绝不进聊天。

set -euo pipefail
SVCE_PREFIX="secret:"
ACCT="nusun"

cmd="${1:-}"
name="${2:-}"
value="${3:-}"

case "$cmd" in
  set)
    [ -z "$name" ] && { echo "用法: secret set <name> <value>" >&2; exit 1; }
    [ -z "$value" ] && { echo "用法: secret set <name> <value>" >&2; exit 1; }
    security delete-generic-password -s "${SVCE_PREFIX}${name}" -a "$ACCT" >/dev/null 2>&1 || true
    security add-generic-password -s "${SVCE_PREFIX}${name}" -a "$ACCT" -w "$value" \
      -T /usr/bin/security -T /bin/bash
    echo "已写入 Keychain: ${name}"
    ;;
  get)
    [ -z "$name" ] && { echo "用法: secret get <name>" >&2; exit 1; }
    security find-generic-password -s "${SVCE_PREFIX}${name}" -a "$ACCT" -w 2>/dev/null \
      || { echo "未找到: ${name}" >&2; exit 1; }
    ;;
  del)
    [ -z "$name" ] && { echo "用法: secret del <name>" >&2; exit 1; }
    security delete-generic-password -s "${SVCE_PREFIX}${name}" -a "$ACCT" >/dev/null 2>&1 || true
    echo "已删除: ${name}"
    ;;
  ls)
    security dump-keychain 2>/dev/null | grep -oE "svce\"<blob>=\"secret:[^\"]+\"" | sed 's/svce"<blob>"="secret://' | sort -u
    ;;
  *)
    echo "secret — 统一密文节点(Keychain)" >&2
    echo "用法:" >&2
    echo "  secret set <name> <value>" >&2
    echo "  secret get <name>" >&2
    echo "  secret del <name>" >&2
    echo "  secret ls" >&2
    exit 1
    ;;
esac
