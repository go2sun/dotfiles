# ~/.ssh/config 模板 (由 dotfiles 管理) — 双 GitHub 账号
# install.sh 会把它部署到 ~/.ssh/config
# 注意: 私钥 (id_rsa / id_ed25519_work) 不在仓库中,需新机手动放置或重新生成

# ===== GitHub 双账号 =====
# 个人: go2sun (默认) — 使用 id_rsa
Host github.com github-personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_rsa
  IdentitiesOnly yes

# 工作: sunusun-me — 使用 id_ed25519_work
Host github-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_work
  IdentitiesOnly yes
